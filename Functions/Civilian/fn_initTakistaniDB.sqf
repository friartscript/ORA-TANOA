private _foundFemaleFaces = [];
{
    private _faceCat = _x;
    {
        private _fName = configName _x;
        if (
            (toLower _fName find "tcgm" != -1) ||
            (toLower _fName find "female" != -1) ||
            (toLower _fName find "woman" != -1) ||
            (toLower _fName find "girl" != -1)
        ) then {
            _foundFemaleFaces pushBackUnique _fName;
        };
    } forEach ("true" configClasses _faceCat);
} forEach ("true" configClasses (configFile >> "CfgFaces"));

if (count _foundFemaleFaces == 0) then {
    _foundFemaleFaces = ["TanoanHead_A3_01"];
};

MISSION_CivilianFemaleFaces = _foundFemaleFaces;

private _allFoundFemales = [];
{
    private _cName = configName _x;
    if (getNumber (_x >> "scope") >= 2 && { _cName isKindOf "Man" }) then {
        _allFoundFemales pushBack _cName;
    };
} forEach ("(toLower configName _x find 'woman' != -1 || toLower configName _x find 'tcgm' != -1 || toLower configName _x find 'female' != -1 || toLower configName _x find 'girl' != -1) && !((toLower configName _x) find 'weapon' != -1) && !((toLower configName _x) find 'tak' != -1)" configClasses (configFile >> "CfgVehicles"));

_allFoundFemales = _allFoundFemales select { isClass (configFile >> "CfgVehicles" >> _x) };

if (count _allFoundFemales == 0) then {
    _allFoundFemales = ["C_man_1"];
};

MISSION_CivilianClasses_Female = _allFoundFemales;

