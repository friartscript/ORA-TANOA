<Keys>
    <Key ID="STR_LL_Song_Verse_01">
        <Original>The Legion marches to the front</Original>
        <English>The Legion marches to the front</English>
        <French>La Légion marche vers le front</French>
        <Spanish>La Legión marcha hacia el frente</Spanish>
        <German>Die Legion marschiert an die Front</German>
        <Italian>La Legione marcia verso il fronte</Italian>
        <Polish>Legia maszeruje na front</Polish>
        <Portuguese>A Legião marcha para a frente</Portuguese>
        <Russian>Легион марширует на фронт</Russian>
        <Czech>Legie pochoduje na front</Czech>
        <Korean>외인부대가 전선으로 행진한다</Korean>
        <Japanese>外人部隊は前線へと進軍する</Japanese>
        <Chinese>外籍軍團奔赴前線</Chinese>
        <Chinesesimp>外籍军团奔赴前线</Chinesesimp>
        <Turkish>Lejyon cepheye doğru yürüyor</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_02">
        <Original>Singing, we follow</Original>
        <English>Singing, we follow</English>
        <French>En chantant nous suivons</French>
        <Spanish>Cantando la seguimos</Spanish>
        <German>Singend folgen wir</German>
        <Italian>Cantando noi seguiamo</Italian>
        <Polish>Śpiewając idziemy za nią</Polish>
        <Portuguese>Cantando nós seguimos</Portuguese>
        <Russian>С песней мы следуем за ней</Russian>
        <Czech>Se zpěvem ji následujeme</Czech>
        <Korean>우리는 노래하며 뒤따른다</Korean>
        <Japanese>歌いながら我らは従う</Japanese>
        <Chinese>高歌隨行</Chinese>
        <Chinesesimp>高歌随行</Chinesesimp>
        <Turkish>Şarkı söyleyerek takip ediyoruz</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_03">
        <Original>Heirs to its traditions</Original>
        <English>Heirs to its traditions</English>
        <French>Héritiers de ses traditions</French>
        <Spanish>Herederos de sus tradiciones</Spanish>
        <German>Erben ihrer Traditionen</German>
        <Italian>Eredi delle sue tradizioni</Italian>
        <Polish>Spadkobiercy jej tradycji</Polish>
        <Portuguese>Herdeiros de suas tradições</Portuguese>
        <Russian>Наследники её традиций</Russian>
        <Czech>Dědicové jejích tradic</Czech>
        <Korean>전통의 계승자들</Korean>
        <Japanese>伝統を受け継ぐ者たち</Japanese>
        <Chinese>傳統之繼承者</Chinese>
        <Chinesesimp>传统之继承者</Chinesesimp>
        <Turkish>Geleneklerinin mirasçıları</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_04">
        <Original>We too, we march</Original>
        <English>We too, we march</English>
        <French>Nous aussi nous marchons</French>
        <Spanish>Nosotros también marchamos</Spanish>
        <German>Auch wir marschieren</German>
        <Italian>Anche noi marciamo</Italian>
        <Polish>My także maszerujemy</Polish>
        <Portuguese>Nós também marchamos</Portuguese>
        <Russian>И мы тоже маршируем</Russian>
        <Czech>My také pochodujeme</Czech>
        <Korean>우리 또한 행진한다</Korean>
        <Japanese>我らもまた進軍する</Japanese>
        <Chinese>我等亦在前行</Chinese>
        <Chinesesimp>我等亦在前行</Chinesesimp>
        <Turkish>Biz de yürüyoruz</Turkish>
    </Key>
