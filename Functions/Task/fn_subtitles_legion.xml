    <Key ID="STR_LL_Song_Verse_06">
        <Original>We are the men of the assault troops</Original>
        <English>We are the men of the assault troops</English>
        <French>Nous sommes les hommes des troupes d'assaut</French>
        <Spanish>Somos los hombres de las tropas de asalto</Spanish>
        <German>Wir sind die Männer der Sturmtruppen</German>
        <Italian>Siamo gli uomini delle truppe d'assalto</Italian>
        <Polish>Jesteśmy ludźmi oddziałów szturmowych</Polish>
        <Portuguese>Somos os homens das tropas de assalto</Portuguese>
        <Russian>Мы — бойцы штурмовых отрядов</Russian>
        <Czech>Jsme muži útočných jednotek</Czech>
        <Korean>우리는 돌격대의 용사들</Korean>
        <Japanese>我らは突撃部隊の兵士</Japanese>
        <Chinese>我等乃突擊先鋒</Chinese>
        <Chinesesimp>我等乃突击先锋</Chinesesimp>
        <Turkish>Biz hücum kıtalarının erleriyiz</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_07">
        <Original>Soldiers of the old Legion</Original>
        <English>Soldiers of the old Legion</English>
        <French>Soldats de la vieille Légion</French>
        <Spanish>Soldados de la vieja Legión</Spanish>
        <German>Soldaten der alten Legion</German>
        <Italian>Soldati della vecchia Legione</Italian>
        <Polish>Żołnierze starej Legii</Polish>
        <Portuguese>Soldados da velha Legião</Portuguese>
        <Russian>Солдаты старого Легиона</Russian>
        <Czech>Vojáci staré Legie</Czech>
        <Korean>유서 깊은 외인부대의 군인들</Korean>
        <Japanese>古き外人部隊の兵士たち</Japanese>
        <Chinese>老牌軍團的戰士</Chinese>
        <Chinesesimp>老牌军团的战士</Chinesesimp>
        <Turkish>Kadim Lejyonun askerleri</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_08">
        <Original>Tomorrow brandishing our banners</Original>
        <English>Tomorrow brandishing our banners</English>
        <French>Demain brandissant nos drapeaux</French>
        <Spanish>Mañana enarbolando nuestras banderas</Spanish>
        <German>Morgen unsere Fahnen schwenkend</German>
        <Italian>Domani sventolando le nostre bandiere</Italian>
        <Polish>Jutro wznosząc nasze sztandary</Polish>
        <Portuguese>Amanhã empunhando nossas bandeiras</Portuguese>
        <Russian>Завтра, высоко подняв наши знамёна</Russian>
        <Czech>Zítra pozvedneme své prapory</Czech>
        <Korean>내일 우리의 깃발을 드높이며</Korean>
        <Japanese>明日 我らの軍旗を掲げて</Japanese>
        <Chinese>明日高揚我等旗幟</Chinese>
        <Chinesesimp>明日高扬我等旗帜</Chinesesimp>
        <Turkish>Yarın bayraklarımızı dalgalandırarak</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_09">
        <Original>As victors we will march</Original>
        <English>As victors we will march</English>
        <French>En vainqueurs nous défilerons</French>
        <Spanish>Como vencedores desfilaremos</Spanish>
        <German>Als Sieger werden wir marschieren</German>
        <Italian>Da vincitori sfileremo</Italian>
        <Polish>Jako zwycięzcy przedefilujemy</Polish>
        <Portuguese>Como vencedores nós desfilaremos</Portuguese>
        <Russian>Победителями мы пройдём строем</Russian>
        <Czech>Jako vítězové budeme defilovat</Czech>
        <Korean>승리자로서 당당히 행진하리라</Korean>
        <Japanese>勝者として我らは行進する</Japanese>
        <Chinese>凱旋受閱行進</Chinese>
        <Chinesesimp>凯旋受阅行进</Chinesesimp>
        <Turkish>Zafer kazananlar olarak geçit yapacağız</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_10">
        <Original>For this knightly destiny</Original>
        <English>For this knightly destiny</English>
        <French>Pour ce destin de chevalier</French>
        <Spanish>Por este destino de caballero</Spanish>
        <German>Für dieses ritterliche Schicksal</German>
        <Italian>Per questo destino da cavaliere</Italian>
        <Polish>Dla tego rycerskiego przeznaczenia</Polish>
        <Portuguese>Por este destino de cavaleiro</Portuguese>
        <Russian>Ради этого рыцарского жребия</Russian>
        <Czech>Pro tento rytířský osud</Czech>
        <Korean>이 기사도적 운명을 위해</Korean>
        <Japanese>この騎士たる運命のために</Japanese>
        <Chinese>為這騎士之宿命</Chinese>
        <Chinesesimp>为这骑士之宿命</Chinesesimp>
        <Turkish>Bu şövalye kaderi uğruna</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_11">
        <Original>Honor, fidelity</Original>
        <English>Honor, fidelity</English>
        <French>Honneur, fidélité</French>
        <Spanish>Honor, fidelidad</Spanish>
        <German>Ehre, Treue</German>
        <Italian>Onore, fedeltà</Italian>
        <Polish>Honor, wierność</Polish>
        <Portuguese>Honra, fidelidade</Portuguese>
        <Russian>Честь и верность</Russian>
        <Czech>Čest, věrnost</Czech>
        <Korean>명예와 충성</Korean>
        <Japanese>名誉、忠誠</Japanese>
        <Chinese>榮譽與忠誠</Chinese>
        <Chinesesimp>荣誉与忠诚</Chinesesimp>
        <Turkish>Onur, sadakat</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_12">
        <Original>We are proud to belong</Original>
        <English>We are proud to belong</English>
        <French>Nous sommes fiers d'appartenir</French>
        <Spanish>Estamos orgullosos de pertenecer</Spanish>
        <German>Wir sind stolz dazuzugehören</German>
        <Italian>Siamo fieri di appartenere</Italian>
        <Polish>Jesteśmy dumni, że należymy</Polish>
        <Portuguese>Temos orgulho de pertencer</Portuguese>
        <Russian>Мы гордимся тем, что принадлежим</Russian>
        <Czech>Jsme hrdí, že patříme</Czech>
        <Korean>우리는 긍지 높게 함께하노라</Korean>
        <Japanese>我らは誇り高く属する</Japanese>
        <Chinese>我等為之自豪</Chinese>
        <Chinesesimp>我等为之自豪</Chinesesimp>
        <Turkish>Ait olmaktan gurur duyuyoruz</Turkish>
    </Key>
    <Key ID="STR_LL_Song_Verse_13">
        <Original>To those who are about to die</Original>
        <English>To those who are about to die</English>
        <French>À ceux qui vont mourir</French>
        <Spanish>A aquellos que van a morir</Spanish>
        <German>Zu jenen, die sterben werden</German>
        <Italian>A coloro che stanno per morire</Italian>
        <Polish>Do tych, którzy idą na śmierć</Polish>
        <Portuguese>Àqueles que vão morrer</Portuguese>
        <Russian>К тем, кто идёт на смерть</Russian>
        <Czech>K těm, kteří jdou na smrt</Czech>
        <Korean>죽음을 향해 나아가는 이들에게</Korean>
        <Japanese>死に向かいゆく者たちに</Japanese>
        <Chinese>投身赴死之人</Chinese>
        <Chinesesimp>投身赴死之人</Chinesesimp>
        <Turkish>Ölüme gidenlerin safına</Turkish>
    </Key>
